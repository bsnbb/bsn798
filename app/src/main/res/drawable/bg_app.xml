<?xml version="1.0" encoding="utf-8"?>
<!-- 应用背景：深蓝紫渐变 + 光斑感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0A0F16"
                android:centerColor="#0E1620"
                android:endColor="#12101F"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
